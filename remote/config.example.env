# Copy to assistant/.runtime/discord.env and fill locally. Never paste this token in a chat.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
# inbox: inbox cards only (default). tasks,inbox: also task outcomes. Empty: no proactive notifications.
DISCORD_NOTIFY=inbox
# Only set if the workbench does not use its default port 18787.
# PHD_DASHBOARD_PORT=18787
